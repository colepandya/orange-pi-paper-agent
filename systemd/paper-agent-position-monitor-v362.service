[Unit]
Description=Paper Agent V3.6.2 live open-position event monitor
After=paper-agent-broad.service paper-agent-v36.service
[Service]
Type=oneshot
User=paperagent
Group=paperagent
WorkingDirectory=/opt/paper-agent
Environment=PYTHONPATH=/opt/paper-agent/app
ExecStart=/usr/bin/python3 /opt/paper-agent/app/position_monitor_v362.py
Nice=16
CPUQuota=40%
MemoryMax=180M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/paper-agent
