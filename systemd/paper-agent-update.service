[Unit]
Description=Update Paper Agent from GitHub (tests gate the install; no-op when unchanged)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
TimeoutStartSec=1200
# the update runs the installer (and tests): keep it from ever starving the live bot on a 730 MB machine
Nice=15
IOSchedulingClass=idle
MemoryMax=380M
CPUQuota=70%
ExecStart=/bin/bash /opt/paper-agent/scripts/update.sh
