[Unit]
Description=Paper Agent V3.5 trader dashboard
After=network.target
[Service]
Type=simple
User=paperagent
Group=paperagent
WorkingDirectory=/opt/paper-agent
Environment=PAPER_AGENT_DB=/var/lib/paper-agent/paper-agent.db
Environment=PAPER_AGENT_PORT=8088
ExecStart=/usr/bin/python3 /opt/paper-agent/app/dashboard_v35.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/paper-agent
[Install]
WantedBy=multi-user.target
